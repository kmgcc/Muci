{
  "type": "layer",
  "id": "backing",
  "hitTesting": false,
  "frame": { "x": "50%", "y": "50%", "width": "100%", "height": "100%" },
  "depth": "=let.bkDepth",
  "offsetX": "=let.slotUnit * let.bkSlideX + let.bkParX",
  "offsetY": "=let.slotUnit * let.bkSlideY + let.bkParY",
  "children": [
    {
      "type": "repeat",
      "id": "backingLine",
      "layout": "free",
      "items": "=(props.group ?? 0) == 0 ? slice(props.line.items ?? [], props.line.nm ?? 0, props.line.nb ?? 0) : slice(props.line.items ?? [], (props.line.nm ?? 0) + (props.line.nb ?? 0))",
      "limit": 40,
      "hitTesting": false,
      "frame": { "x": "50%", "y": "50%", "width": "100%", "height": "100%" },
      "template": {
        "type": "text",
        "id": "backingWord",
        "text": "=item.t",
        "font": "=item.k == 1 ? props.line.font.cjk : props.line.font.latin",
        "weight": "=props.line.font.weight",
        "fontSize": "=100 * let.slotUnit * item.s",
        "lineLimit": "=item.v == 1 ? 24 : 1",
        "alignment": "center",
        "color": "=let.gColor",
        "rotation": "=item.r",
        "subpixel": true,
        "visible": "=clock.lyrics >= item.start - 0.5 && let.slotShown && let.gShown",
        "frame": {
          "x": "=viewport.width / 2 + let.slotUnit * (props.line.cam.x + item.x) + let.slotDX",
          "y": "=viewport.height / 2 + let.slotUnit * (props.line.cam.y + item.y) + let.slotDY",
          "width": "=item.v == 1 ? 112 * let.slotUnit * item.s : null"
        },
        "glyphMotion": {
          "opacity": "=smoothstep(0, 0.4 * let.gEntry, let.gSince + 0.25) * let.slotFade * (1 - let.gRest) * (1 - let.bkOut)",
          "scale": "=(1 + (1 - let.gIn) * (item.m == 1 ? (item.k == 1 ? 0.2 : 0.35) : (item.m == 2 ? -0.15 : (item.k == 1 ? 0 : -0.1)))) * (1 - 0.18 * let.bkOut)",
          "rotation": "=item.m == 2 || item.m == 4 ? (1 - let.gIn) * (item.ex >= 0 ? 1 : -1) * (item.m == 2 ? (item.k == 1 ? 14 : 28) : 6) : 0",
          "x": "=(1 - let.gIn) * let.gTravel * (item.m == 3 ? (item.r > 45 ? item.ex : -item.ey) * (mod(glyph.index, 2) == 0 ? 1 : -1) : (item.r > 45 ? item.ey : item.ex))",
          "y": "=(1 - let.gIn) * let.gTravel * (item.m == 3 ? (item.r > 45 ? item.ey : item.ex) * (mod(glyph.index, 2) == 0 ? 1 : -1) : (item.r > 45 ? -item.ex : item.ey)) + sin(time * motion.speed * 1.1 - glyph.index * 0.5 - (item.q ?? index) * 0.7) * glyph.fontSize * 0.01 - 0.14 * let.gRest * glyph.fontSize",
          "blur": "=min(18, (1 - easeOut((let.gSince + 0.25) / (0.7 * let.gEntry))) * (item.m == 1 ? 0.16 : 0.1) * glyph.fontSize + (0.12 * let.gRest + 0.16 * let.bkOut + params.backBlur) * glyph.fontSize)"
        }
      }
    }
  ]
}
