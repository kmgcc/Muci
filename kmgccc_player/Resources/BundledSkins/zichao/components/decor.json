        "frame": {
          "x": "=let.dHeroX + let.slotUnit * cos(let.dEchoAngle) * (let.dHeroSpan * 0.55 + 40 + 80 * random(index * 8.9 + props.line.index * 0.6)) * (1 + 0.3 * clamp(let.dEchoAge, 0, 0.42))",
          "y": "=let.dHeroY + let.slotUnit * sin(let.dEchoAngle) * (let.dHeroSpan * 0.5 + 35 + 60 * random(index * 8.9 + props.line.index * 0.6)) * (1 + 0.3 * clamp(let.dEchoAge, 0, 0.42))",
          "width": "=props.line.heroItem.v == 1 ? 112 * let.slotUnit * (props.line.heroItem.s ?? 1) * (0.3 + 0.45 * random(index * 3.7 + props.line.index * 1.3)) : null"
        },
        "depth": "=(random(index * 6.1 + props.line.index * 0.9) - 0.4) * 1.4"
      }
    }
  ]
}
