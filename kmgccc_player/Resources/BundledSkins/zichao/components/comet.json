{
  "type": "layer",
  "id": "comets",
  "hitTesting": false,
  "visible": "=props.line.index >= state.line.index - 1 && !let.slotNext",
  "frame": { "x": "50%", "y": "50%", "width": "100%", "height": "100%" },
  "children": [
    {
      "type": "comet",
      "id": "heroComet",
      "visible": "=props.line.comet.count >= 1 && props.line.hero >= 0",
      "orbit": "=[let.slotUnit * ((props.line.heroItem.w ?? 100) / 2 + 36), let.slotUnit * ((props.line.heroItem.h ?? 100) / 2 + 28)]",
      "progress": "=clamp((clock.lyrics - (props.line.heroItem.start ?? 0) + 0.36) / clamp(1.2 + 0.4 * ((props.line.heroItem.end ?? 0) - (props.line.heroItem.start ?? 0)), 1.2, 2.8), 0, 1)",
      "angle": "=props.line.comet.angle",
      "sweep": "=props.line.comet.sweep * (210 + 110 * random(props.line.index * 1.3 + 0.2))",
      "trail": 0.16,
      "size": "=max(1.6, viewport.min * 0.0013 * params.cometSize)",
      "width": "=max(1.6, viewport.min * 0.0013 * params.cometSize) * (params.brush > 0 ? params.brushWidth : 1)",
      "brush": { "amount": "=params.brush", "dry": "=params.brushDry" },
      "seed": "=props.line.index",
      "color": "=withLightness(saturate(theme.accent, 1.5), 0.8)",
      "blendMode": "plusLighter",
      "frame": {
        "x": "=viewport.width / 2 + let.slotUnit * (props.line.cam.x + (props.line.heroItem.x ?? 0))",
        "y": "=viewport.height / 2 + let.slotUnit * (props.line.cam.y + (props.line.heroItem.y ?? 0))",
        "width": "=min(viewport.width * 1.5, 5.6 * let.slotUnit * ((props.line.heroItem.w ?? 100) / 2 + 36) + 40)",
        "height": "=min(viewport.height * 1.5, 5.6 * let.slotUnit * ((props.line.heroItem.h ?? 100) / 2 + 28) + 40)"
      }
    },
    {
      "type": "comet",
      "id": "lineComet",
      "visible": "=props.line.comet.count >= 2",
      "orbit": "=[let.slotUnit * (props.line.size[0] / 2 + 60), let.slotUnit * (props.line.size[1] / 2 + 50)]",
      "progress": "=clamp((clock.lyrics - props.line.t0 + 0.1) / clamp(props.line.dur * 0.6, 1.5, 3.2), 0, 1)",
      "angle": "=props.line.comet.angle + 150",
      "sweep": "=-props.line.comet.sweep * (150 + 90 * random(props.line.index * 2.1 + 0.6))",
      "trail": 0.12,
      "size": "=max(1.3, viewport.min * 0.001 * params.cometSize)",
      "width": "=max(1.3, viewport.min * 0.001 * params.cometSize) * (params.brush > 0 ? params.brushWidth : 1)",
      "brush": { "amount": "=params.brush", "dry": "=params.brushDry" },
      "seed": "=props.line.index + 0.5",
      "color": "=mix(theme.accent, #FFFFFF, 0.85)",
      "blendMode": "plusLighter",
      "frame": {
        "x": "=viewport.width / 2 + let.slotUnit * props.line.cam.x",
        "y": "=viewport.height / 2 + let.slotUnit * props.line.cam.y",
        "width": "=min(viewport.width * 1.5, 5.6 * let.slotUnit * (props.line.size[0] / 2 + 60) + 40)",
        "height": "=min(viewport.height * 1.5, 5.6 * let.slotUnit * (props.line.size[1] / 2 + 50) + 40)"
      }
    },
    {
      "type": "comet",
      "id": "wordComet",
      "visible": "=props.line.comet.count >= 3 && props.line.comet.word >= 0",
      "orbit": "=[let.slotUnit * ((props.line.items[props.line.comet.word].w ?? 100) / 2 + 24), let.slotUnit * ((props.line.items[props.line.comet.word].h ?? 100) / 2 + 20)]",
      "progress": "=clamp((clock.lyrics - (props.line.items[props.line.comet.word].start ?? 0) + 0.3) / 1.3, 0, 1)",
      "angle": "=props.line.comet.angle - 120",
      "sweep": "=props.line.comet.sweep * 260",
      "trail": 0.14,
      "size": "=max(1.2, viewport.min * 0.0009 * params.cometSize)",
      "width": "=max(1.2, viewport.min * 0.0009 * params.cometSize) * (params.brush > 0 ? params.brushWidth : 1)",
      "brush": { "amount": "=params.brush", "dry": "=params.brushDry" },
      "seed": "=props.line.index + 0.25",
      "color": "=withLightness(saturate(theme.accent, 1.4), 0.86)",
      "blendMode": "plusLighter",
      "frame": {
        "x": "=viewport.width / 2 + let.slotUnit * (props.line.cam.x + (props.line.items[props.line.comet.word].x ?? 0))",
        "y": "=viewport.height / 2 + let.slotUnit * (props.line.cam.y + (props.line.items[props.line.comet.word].y ?? 0))",
        "width": "=min(viewport.width * 1.5, 5.6 * let.slotUnit * ((props.line.items[props.line.comet.word].w ?? 100) / 2 + 24) + 40)",
        "height": "=min(viewport.height * 1.5, 5.6 * let.slotUnit * ((props.line.items[props.line.comet.word].h ?? 100) / 2 + 20) + 40)"
      }
    }
  ]
}
