    "slotShown": "=let.slotStay ?!(let.slotResting && clock.lyrics - state.gap.t0 > props.line.fade + 0.5) : clock.lyrics - (state.line.leaveAt ?? state.line.t0) < let.slotOut + params.leaveLead && state.line.t0 - clock.lyrics < let.slotOut + params.leaveLead &&!(props.line.t0 <= state.gap.t0 && state.gap.t0 <= state.line.t0 && clock.lyrics - state.gap.t0 > props.line.fade + 0.5)",
