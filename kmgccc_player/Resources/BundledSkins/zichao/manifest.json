    "scrollSpeedX": "=followVelocity(let.camScrollX, let.camLineCurve)",
    "scrollSpeedY": "=followVelocity(let.camScrollY, let.camLineCurve)",

    "slotUnit": "=viewport.min * 0.00066 * props.line.k",
    "slotLive": "=props.line.index == state.line.index",
    "slotNext": "=props.line.index == state.line.index + 1 && props.line.track == state.line.track",
