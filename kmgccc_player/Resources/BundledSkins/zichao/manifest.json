    "slotDirY": "=let.slotLive ? (state.line.upcoming.leave.y ?? 0) : (let.slotLeaveDir ? state.line.leave.y : (abs(props.line.cam.y - state.line.cam.y) <= abs(props.line.cam.x - state.line.cam.x) ? 0 : (props.line.cam.y >= state.line.cam.y ? 1 : -1)))",
