    "fRAngle": "=random(props.line.index * 8.3 + index * 2.9 + 0.2)",
    "fRole": "=index + floor(4 * random(props.line.index * 4.4 + 0.15)) - 4 * floor((index + floor(4 * random(props.line.index * 4.4 + 0.15))) / 4)",
    "fDepth": "=let.fRole == 0 ? -0.55 + 0.2 * let.fRDepth : (let.fRole == 1 ? 0.1 * let.fRDepth - 0.05 : (let.fRole == 2 ? 1.1 + 1.1 * let.fRDepth : 0.25 + 2.3 * pow(let.fRDepth, 1.4)))",
