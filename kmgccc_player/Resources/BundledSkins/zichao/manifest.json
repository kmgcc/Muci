    "dY": "=viewport.height / 2 + let.slotUnit * props.line.cam.y + let.slotDY",
    "dHeroX": "=let.dX + let.slotUnit * (props.line.heroBox.x ?? 0)",
    "dHeroY": "=let.dY + let.slotUnit * (props.line.heroBox.y ?? 0)",
    "dHeroSpan": "=max(props.line.heroBox.w ?? 0, props.line.heroBox.h ?? 0)",
    "dAge": "=clock.lyrics - props.line.t0",
    "dAccentAge": "=clock.lyrics - (props.line.accent.start ?? -100000)",
