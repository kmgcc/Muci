    "fTone": "=let.fDepth < 0 ? 0.66 : clamp(0.6 - 0.09 * let.fDepth, 0.38, 0.6)",
    "fChroma": "=let.fDepth < 0 ? 1.5 : clamp(1.4 - 0.25 * let.fDepth, 0.8, 1.4)",
    "fGiantOn": "=random(props.line.index * 2.71 + 0.3) < 0.12",
    "fGiantKind": "=random(props.line.index * 4.33 + 0.7)",
    "fGiantSide": "=viewport.min * (1.1 + 0.5 * random(props.line.index * 7.7 + 0.2))",
    "fGiantAngle": "=random(props.line.index * 6.1 + 0.9) * 2 * pi",
    "fGiantDepth": "=0.07 + 0.1 * random(props.line.index * 3.9 + 0.5)",
    "fGiantFollow": "=1 / (1 + let.fGiantDepth)",
