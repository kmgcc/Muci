    "titleGo": "=!let.endCard && (host.lyricsVisible || host.queueVisible || let.lyricsDone) && lyrics.available && lyrics.lineCount > 0 && (state.line.index >= 0 || clock.lyrics >= (lyrics.lines[0].start ?? 0) - 1.2) ? 1 : 0",
