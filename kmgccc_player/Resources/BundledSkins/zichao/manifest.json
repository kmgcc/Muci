    "camFollowX": "=clamp(clamp(let.camFollowGain * (let.camFocusX - (1 - let.camNudge) * clamp(let.camFocusX, -let.camFreeX, let.camFreeX)), let.camFocusX - let.camKeepX, let.camFocusX + let.camKeepX), -let.camCapX, let.camCapX)",
