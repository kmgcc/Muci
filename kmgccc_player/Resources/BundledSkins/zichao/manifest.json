    "gapBreath": "=follow(state.gap.on == 1 && !host.detailVisible ? min(1.5, params.camera) * params.breath : 0, 'camDrift', let.camEase)",
    "gapBreathX": "=viewport.min * let.gapBreath * (sin(time * motion.speed * 0.17 + 0.6) * 0.022 + sin(time * motion.speed * 0.067 + 2.3) * 0.014)",
    "gapBreathY": "=viewport.min * let.gapBreath * (sin(time * motion.speed * 0.13 + 1.9) * 0.016 + sin(time * motion.speed * 0.053 + 0.2) * 0.012)",
    "gapBreathZoom": "=1 + let.gapBreath * (0.03 * sin(time * motion.speed * 0.11 + 0.8) + 0.012 * sin(time * motion.speed * 0.047))",
