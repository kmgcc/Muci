    "camWordA": "=state.line.items[let.wordIndex] ?? state.word",
    "camWordB": "=state.line.items[min(let.wordIndex + 1, max(0, let.ownCount - 1))] ?? state.word",
    "camWordGap": "=max(0.001, (let.camWordB.start ?? clock.lyrics) - (let.camWordA.start ?? clock.lyrics))",
    "camLeadUse": "=min(let.camLead, 0.5 * let.camWordGap)",
    "camLeadEnd": "=(let.camWordB.start ?? clock.lyrics) - 0.25 * let.camLeadUse",
