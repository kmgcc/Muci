    "dFade": "=let.dShow * (let.slotResting ? 1 - smoothstep(0, 0.6, clock.lyrics - state.gap.t0) : 1)",
    "dDraw": "=easeInOut(clamp(let.dAge / max(0.8, props.line.dur * 0.7), 0, 1))",
    "dEchoAge": "=let.dAccentAge - 0.05 - 1.3 * random(index * 5.3 + props.line.index * 0.77)",
    "dEchoAngle": "=(index / 10 + 0.05 * random(index * 7.3 + props.line.index * 2.1) + random(props.line.index * 3.3 + 0.4)) * 2 * pi",
    "dDiskSpan": "=clamp(0.45 + 0.3 * (props.line.accent.dur ?? 1), 0.6, 1.1)",
