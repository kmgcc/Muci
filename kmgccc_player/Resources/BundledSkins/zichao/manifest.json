{
  "formatVersion": 2,
  "hostAPIVersion": 2,
  "version": "4.4.1",
  "author": "kmg",
  "sidebar": {"label": "beta", "showsAuthor": true},
  "preview": {"image": "preview.png", "themed": true},
  "fonts": ["fonts/youyou-yisong.ttf"],
  "descriptor": {
    "id": "user.zichao",
    "name": "字潮",
    "systemImage": "textformat.size",
    "surfaces": ["fullscreen"],
    "presentation": { "backgroundOwner": "skin", "controlForeground": "fixedLight", "panelPlacement": "trailing", "scrollVolume": true, "trackDetail": "scene" }
  },
  "requires": [
    "scene@2",
    "theme@1",
    "track@1",
    "time@1",
    "clock.playback@1",
    "clock.lyrics@1",
    "lyrics.document@1",
    "lyrics.derived@1",
    "lyrics.prefs@1",
    "viewport@1",
    "motion@1",
    "host@1",
    "prefs@1",
    "params@1",
    "state@1",
    "templates@1",
    "repeat@1",
    "text@1",
    "shape@1",
    "gradient@1",
    "particles@1",
    "fog@1",
    "filters@1",
    "glyphMotion@1",
    "camera@1",
    "stroke@1",
    "scripts@1",
    "comet@1",
    "render.gpu@1",
    "filters.lut@1",
    "filters.bokeh@1",
    "filters.fov@1",
    "playback@1",
    "host.pointer@1",
    "artwork@1",
    "events@1",
    "actions@1",
    "control.playPause@1",
    "control.previous@1",
    "control.next@1",
    "control.progressLine@1",
    "control.actionStack@1",
    "control.playbackModeStack@1",
    "panel.queue@1",
    "components@1",
    "visualizer.capsuleSpectrum@1",
    "visualizer.led@1"
  ],
  "parameters": [
    {
      "id": "font",
      "title": "字体",
      "defaultValue": "yisong",
      "control": {
        "type": "choice",
        "choices": [
          { "id": "yisong", "title": "意宋" },
          { "id": "songti", "title": "宋体" },
          { "id": "pingfang", "title": "苹方" },
          { "id": "app", "title": "自定义" }
        ]
      },
      "isUserVisible": true,
      "applies": "nextLine"
    },
    {
      "id": "lyricsLead",
      "title": "歌词提前",
      "defaultValue": 0.2,
      "control": { "type": "range", "min": 0, "max": 1, "step": 0.05 },
      "isUserVisible": true
    },
    {
      "id": "tempo",
      "title": "节奏",
      "defaultValue": 0.5,
      "control": { "type": "range", "min": 0, "max": 1, "step": 0.05 },
      "isUserVisible": true,
      "applies": "nextLine"
    },
    {
      "id": "texture",
      "title": "质感",
      "defaultValue": 0.5,
      "control": { "type": "range", "min": 0, "max": 1, "step": 0.05 },
      "isUserVisible": true
    },
    {
      "id": "lut",
      "title": "色彩",
      "defaultValue": "luts/F-8840-LOG.cube",
      "control": {
        "type": "choice",
        "choices": [
          { "id": "", "title": "无" },
          { "id": "luts/F-8840-LOG.cube", "title": "中性" },
          { "id": "luts/F-9300-LOG.cube", "title": "电影" },
          { "id": "luts/DELUTS_CLOG3_Look_29.cube", "title": "复古" },
          { "id": "luts/C-8020-LOG.cube", "title": "绚烂" }
        ]
      },
      "isUserVisible": true
    },
    {
      "id": "lutAmount",
      "title": "色彩强度",
      "defaultValue": 0.5,
      "control": { "type": "range", "min": 0, "max": 1, "step": 0.05 },
      "isUserVisible": true,
      "visibleWhen": "params.lut != ''"
    },
    { "id": "bgBrightness", "title": "背景亮度", "defaultValue": 1.2, "control": { "type": "range", "min": 0.2, "max": 3, "step": 0.05 } },
    { "id": "bgLUTAmount", "title": "背景调色强度", "defaultValue": 0.8, "control": { "type": "range", "min": 0, "max": 1, "step": 0.05 } },
    { "id": "vignette", "title": "暗角", "defaultValue": 1, "control": { "type": "range", "min": 0, "max": 1, "step": 0.05 } },
    { "id": "emphasis", "title": "重音", "defaultValue": 0.75, "control": { "type": "range", "min": 0, "max": 1, "step": 0.05 } },
    { "id": "particles", "title": "微尘", "defaultValue": 0.5, "control": { "type": "range", "min": 0, "max": 3, "step": 0.1 } },
    { "id": "camera", "title": "镜头摆动", "defaultValue": 1.6, "control": { "type": "range", "min": 0, "max": 3, "step": 0.1 } },
    { "id": "grab", "title": "拖动偏移", "defaultValue": 2, "control": { "type": "range", "min": 0, "max": 2, "step": 0.05 } },
    { "id": "cometSize", "title": "彗星大小", "defaultValue": 1, "control": { "type": "range", "min": 0.4, "max": 3, "step": 0.05 } },
    { "id": "layout", "title": "排版", "defaultValue": "rich", "control": { "type": "choice", "choices": [{ "id": "simple", "title": "简单" }, { "id": "rich", "title": "丰富" }] } },
    { "id": "glowSaturation", "title": "辉光饱和度", "defaultValue": 0.2, "control": { "type": "range", "min": 0, "max": 2, "step": 0.05 } },
    { "id": "bounce", "title": "弹性", "defaultValue": 0.35, "control": { "type": "range", "min": 0, "max": 0.6, "step": 0.05 } },
    { "id": "drift", "title": "漂移", "defaultValue": 1, "control": { "type": "range", "min": 0, "max": 3, "step": 0.1 } },
    { "id": "zoomMove", "title": "缩放运镜", "defaultValue": 2, "control": { "type": "range", "min": 0, "max": 3, "step": 0.1 } },
    { "id": "zoomPush", "title": "缓推", "defaultValue": 1, "control": { "type": "range", "min": 0, "max": 3, "step": 0.1 } },
    { "id": "roll", "title": "倾斜", "defaultValue": 1, "control": { "type": "range", "min": 0, "max": 3, "step": 0.1 } },
    { "id": "tilt", "title": "俯仰", "defaultValue": 1.3, "control": { "type": "range", "min": 0, "max": 3, "step": 0.1 } },
    { "id": "perspective", "title": "透视", "defaultValue": 1, "control": { "type": "range", "min": 0.1, "max": 1.5, "step": 0.05 } },
    { "id": "spinChance", "title": "斜拍机会", "defaultValue": 0.1, "control": { "type": "range", "min": 0, "max": 0.5, "step": 0.01 } },
    { "id": "spinAngle", "title": "斜拍角度", "defaultValue": 1.35, "control": { "type": "range", "min": 0, "max": 2, "step": 0.05 } },
    { "id": "spinTime", "title": "斜拍转速", "defaultValue": 1.6, "control": { "type": "range", "min": 0.4, "max": 3, "step": 0.1 } },
    { "id": "grabTilt", "title": "拖动偏转", "defaultValue": 0.4, "control": { "type": "range", "min": -2, "max": 2, "step": 0.1 } },
    { "id": "grabReturn", "title": "松手回位", "defaultValue": 1, "control": { "type": "range", "min": 0.4, "max": 3, "step": 0.1 } },
    { "id": "leaveDist", "title": "退场距离", "defaultValue": 0.4, "control": { "type": "range", "min": 0, "max": 1, "step": 0.05 } },
    { "id": "leaveLead", "title": "退场提前", "defaultValue": 0.4, "control": { "type": "range", "min": 0, "max": 1.5, "step": 0.05 } },
    { "id": "holdFloat", "title": "停顿漂浮", "defaultValue": 1, "control": { "type": "range", "min": 0, "max": 3, "step": 0.1 } },
    { "id": "breath", "title": "间奏呼吸", "defaultValue": 1, "control": { "type": "range", "min": 0, "max": 3, "step": 0.1 } },
    { "id": "backDepth", "title": "和声景深", "defaultValue": 1.2, "control": { "type": "range", "min": 0, "max": 3, "step": 0.05 } },
    { "id": "backBlur", "title": "和声虚化", "defaultValue": 0.05, "control": { "type": "range", "min": 0, "max": 0.15, "step": 0.005 } },
    { "id": "backGlide", "title": "和声移位时长", "defaultValue": 1, "control": { "type": "range", "min": 0.3, "max": 3, "step": 0.1 } },
    { "id": "backLeave", "title": "和声退场时长", "defaultValue": 0.55, "control": { "type": "range", "min": 0.1, "max": 1, "step": 0.05 } },
    { "id": "motionBlur", "title": "运动模糊", "defaultValue": 0.6, "control": { "type": "range", "min": 0, "max": 2, "step": 0.05 } },
    { "id": "defocus", "title": "虚焦机会", "defaultValue": 0.05, "control": { "type": "range", "min": 0, "max": 1, "step": 0.01 } },
    { "id": "defocusRadius", "title": "虚焦半径", "defaultValue": 22, "control": { "type": "range", "min": 6, "max": 64, "step": 1 } },
    { "id": "defocusWave", "title": "对焦方式", "defaultValue": "random", "control": { "type": "choice", "choices": [{ "id": "random", "title": "随机" }, { "id": "hunt", "title": "搜焦" }, { "id": "flutter", "title": "颤动" }, { "id": "drift", "title": "恍惚" }, { "id": "snap", "title": "抽动" }] } },
    { "id": "defocusSpeed", "title": "对焦速度", "defaultValue": 1.15, "control": { "type": "range", "min": 0.3, "max": 1.5, "step": 0.05 } },
    { "id": "defocusGlow", "title": "光斑亮度", "defaultValue": 0.2, "control": { "type": "range", "min": 0, "max": 1, "step": 0.05 } },
    { "id": "defocusThreshold", "title": "光斑门槛", "defaultValue": 0.6, "control": { "type": "range", "min": 0, "max": 1, "step": 0.05 } },
    { "id": "defocusSwirl", "title": "旋焦", "defaultValue": 1, "control": { "type": "range", "min": 0, "max": 1, "step": 0.05 } },
    { "id": "defocusBreathing", "title": "对焦呼吸", "defaultValue": 1.9, "control": { "type": "range", "min": 0, "max": 3, "step": 0.1 } },
    { "id": "defocusDetail", "title": "虚焦精细度", "defaultValue": 1.2, "control": { "type": "range", "min": 0.4, "max": 2, "step": 0.1 } },
    { "id": "grainRate", "title": "颗粒帧率", "defaultValue": 6, "control": { "type": "range", "min": 1, "max": 24, "step": 1 } },
    { "id": "bgColors", "title": "背景用色", "defaultValue": 6, "control": { "type": "range", "min": 1, "max": 6, "step": 1 } },
    { "id": "bgZoneSize", "title": "色斑大小", "defaultValue": 0.75, "control": { "type": "range", "min": 0.3, "max": 2, "step": 0.05 } },
    { "id": "bgZoneShare", "title": "色斑多少", "defaultValue": 0.5, "control": { "type": "range", "min": 0, "max": 1, "step": 0.05 } },
    { "id": "comets", "title": "彗星", "defaultValue": true, "control": { "type": "toggle" } },
    { "id": "brush", "title": "笔触", "defaultValue": 0.55, "control": { "type": "range", "min": 0, "max": 1, "step": 0.05 } },
    { "id": "brushDry", "title": "飞白", "defaultValue": 0.5, "control": { "type": "range", "min": 0, "max": 1, "step": 0.05 } },
    { "id": "brushWidth", "title": "笔宽", "defaultValue": 2.1, "control": { "type": "range", "min": 1, "max": 6, "step": 0.1 } },
    { "id": "brushWobble", "title": "手绘起伏", "defaultValue": 0.8, "control": { "type": "range", "min": 0, "max": 1, "step": 0.05 } }
  ],
  "let": {
    "fontLatin": "=params.font == 'app' ? (lyrics.prefs.fontFamily ?? '') : (params.font == 'yisong' ? 'youyou-yisong' : (params.font == 'songti' ? 'STSongti-SC-Light' : ''))",
    "fontCJK": "=params.font == 'app' ? (lyrics.prefs.fontFamilyCJK ?? '') : (params.font == 'yisong' ? 'youyou-yisong' : (params.font == 'songti' ? 'STSongti-SC-Light' : 'PingFangSC-Semibold'))",
    "fontWeight": "=params.font == 'app' ? (lyrics.prefs.fontWeight ?? 'bold') : (params.font == 'songti' ? 'light' : 'heavy')",
    "fontCaption": "=params.font == 'app' ? (lyrics.prefs.translationFontFamily ?? lyrics.prefs.fontFamilyCJK ?? '') : (params.font == 'pingfang' ? 'PingFangSC-Medium' : let.fontCJK)",
    "fontCaptionWeight": "=params.font == 'app' ? (lyrics.prefs.translationFontWeight ?? 'medium') : 'medium'",
    "fontScaleApp": "=lyrics.prefs.fontScale ?? (lyrics.prefs.fontSize ?? 53) / (53 * min(viewport.width / 1470, viewport.height / 923))",
    "captionK": "=params.font == 'app' ? clamp((lyrics.prefs.translationFontScale ?? 1) / max(0.1, lyrics.prefs.fontScale ?? 1), 0.3, 3) : 1",
    "defocusWave": "=params.defocusWave == 'hunt' ? 0 : (params.defocusWave == 'flutter' ? 1 : (params.defocusWave == 'drift' ? 2 : (params.defocusWave == 'snap' ? 3 : -1)))",
    "size": "=1.85 * (params.font == 'app' ? clamp(let.fontScaleApp, 0.3, 2.5) : 1)",
    "tempoK": "=clamp(params.tempo, 0, 1)",
    "entryTime": "=let.tempoK < 0.5 ? mix(2, 1.4, 2 * let.tempoK) : mix(1.4, 0.8, 2 * let.tempoK - 1)",
    "entryMin": "=let.tempoK < 0.5 ? mix(0.95, 0.65, 2 * let.tempoK) : mix(0.65, 0.35, 2 * let.tempoK - 1)",
    "lineCut": "=let.tempoK < 0.5 ? mix(0, 0.5, 2 * let.tempoK) : mix(0.5, 1.5, 2 * let.tempoK - 1)",
    "leaveTime": "=let.tempoK < 0.5 ? mix(1, 0.7, 2 * let.tempoK) : mix(0.7, 0.5, 2 * let.tempoK - 1)",
    "emphK": "=clamp(params.emphasis, 0, 1)",
    "accentEnergy": "=let.emphK < 0.5 ? mix(0.6, 2, 2 * let.emphK) : mix(2, 2.8, 2 * let.emphK - 1)",
    "glowStrength": "=let.emphK < 0.5 ? mix(1.2, 4.3, 2 * let.emphK) : mix(4.3, 6, 2 * let.emphK - 1)",
    "glowHaze": "=let.emphK < 0.5 ? mix(0.6, 2.7, 2 * let.emphK) : mix(2.7, 3.6, 2 * let.emphK - 1)",
    "accentPush": "=let.emphK < 0.5 ? mix(0, 1.8, 2 * let.emphK) : mix(1.8, 3, 2 * let.emphK - 1)",
    "textureK": "=clamp(params.texture, 0, 1)",
    "grain": "=let.textureK < 0.5 ? mix(0, 0.05, 2 * let.textureK) : mix(0.05, 0.1, 2 * let.textureK - 1)",
    "vignette": "=clamp(params.vignette, 0, 1)",
    "bgK": "=clamp(params.bgBrightness, 0.1, 4)",
    "edgeBlur": "=let.textureK < 0.5 ? mix(0, 36, 2 * let.textureK) : mix(36, 56, 2 * let.textureK - 1)",
    "edgeStart": "=let.textureK < 0.5 ? mix(0.5, 0.32, 2 * let.textureK) : mix(0.32, 0.22, 2 * let.textureK - 1)",
    "aberration": "=let.textureK < 0.5 ? mix(0, 12, 2 * let.textureK) : mix(12, 20, 2 * let.textureK - 1)",
    "distortion": "=let.textureK < 0.5 ? mix(0, 0.5, 2 * let.textureK) : mix(0.5, 0.6, 2 * let.textureK - 1)",

    "uiS": "=clamp(viewport.min / 900, 0.85, 1.4)",
    "uiPad": "=max(28, viewport.width * 0.03)",
    "uiCover": "=84 * let.uiS",
    "uiBarY": "=viewport.height - max(18, viewport.height * 0.024) - 12 * let.uiS",
    "uiRowY": "=let.uiBarY - 38 * let.uiS",
    "uiTextX": "=let.uiPad + let.uiCover + 18 * let.uiS",
    "uiRight": "=viewport.width - let.uiPad",
    "uiFg": "=mix(theme.accent, #FFFFFF, 0.94)",
    "uiInfoWidth": "=max(120, let.uiRight - 280 * let.uiS - let.uiTextX)",
    "uiZoneTop": "=let.uiRowY - 110 * let.uiS",
    "uiShown": "=!host.quickPanelVisible && (prefs.miniPlayerAutoHide == 0 || !playback.isPlaying || host.queueVisible || (host.pointerInside && ((host.pointerY ?? 0) >= let.uiZoneTop || host.popoutOpen == true)))",

    "infoW": "=min(viewport.width * 0.62, max(320, viewport.min * 0.92))",
    "infoTop": "=viewport.height * 0.26",
    "infoTitleSize": "=max(viewport.min * 0.042, min(viewport.min * 0.075, let.infoW * 100 / max(1, measureText(state.infoDoc.title ?? '', 100, let.fontWeight, let.fontCJK))))",
    "infoTextSize": "=viewport.min * 0.024 * (params.font == 'app' ? clamp(let.fontScaleApp, 0.6, 1.6) : 1)",
    "infoX0": "=(viewport.width - let.infoW) / 2",
    "infoGap": "=viewport.min * 0.022",
    "infoArtistText": "=(state.infoDoc.artist ?? '') + ((state.infoDoc.album ?? '') != '' ? '  ' + state.infoDoc.album : '')",
    "infoArtistSize": "=viewport.min * 0.026",
    "infoNoteSize": "=viewport.min * 0.016",
    "infoTitleH": "=textHeight(state.infoDoc.title ?? '', let.infoTitleSize, let.infoW, let.fontWeight, let.fontCJK, 0, 2)",
    "infoArtistH": "=textHeight(let.infoArtistText, let.infoArtistSize, let.infoW, 'medium', let.fontCaption, 0, 2)",
    "infoTextH": "=textHeight(state.infoDoc.text ?? '', let.infoTextSize, let.infoW, let.fontCaptionWeight, let.fontCaption, let.infoTextSize * 0.7)",
    "infoNoteH": "=(state.infoDoc.note ?? '') != '' ? textHeight(state.infoDoc.note, let.infoNoteSize, let.infoW, 'regular', let.fontCaption) : 0",
    "infoArtistY": "=let.infoTop + let.infoTitleH + let.infoGap",
    "infoRuleY": "=let.infoArtistY + let.infoArtistH + let.infoGap",
    "infoTextY": "=let.infoRuleY + 1.5 + let.infoGap",
    "infoNoteY": "=let.infoTextY + let.infoTextH + let.infoGap",
    "infoCloseH": "=max(30, viewport.min * 0.04)",
    "infoCloseW": "=measureText('关闭', viewport.min * 0.018, 'medium', let.fontCaption) + 2.4 * let.infoCloseH",
    "infoCloseY": "=let.infoNoteY + let.infoNoteH + viewport.min * 0.05 + let.infoCloseH / 2",
    "infoZ": "=clamp(state.infoZoom ?? 1, 0.75, 2.5)",
    "infoZF": "=follow(let.infoZ, {token: 'layout', duration: 0.35, bounce: 0})",
    "infoCy": "=viewport.height / 2",
    "infoRest": "=min(viewport.height * 0.8, let.uiZoneTop - viewport.min * 0.04)",
    "infoMin": "=min(0, let.infoTop - let.infoCy - (viewport.height * 0.14 - let.infoCy) / let.infoZ)",
    "infoMax": "=max(let.infoMin, let.infoCloseY + let.infoCloseH / 2 - let.infoCy - (let.infoRest - let.infoCy) / let.infoZ)",
    "infoPanMax": "=max(0, (let.infoW * let.infoZ - viewport.width * 0.9) / (2 * let.infoZ))",
    "infoCurve": "={token: 'layout', duration: 0.7, bounce: 0}",
    "infoTurn": "={token: 'layout', duration: 1.1, bounce: 0}",
    "infoCamY": "=follow(clamp(state.infoScroll ?? 0, let.infoMin, let.infoMax), let.infoCurve)",
    "infoCamX": "=follow(clamp(state.infoScrollX ?? 0, -let.infoPanMax, let.infoPanMax), let.infoCurve)",
    "infoK": "=follow(host.detailVisible ? 1 : 0, let.infoTurn)",
    "infoSwayX": "=0.6 * let.camSwayX",
    "infoSwayY": "=0.6 * let.camSwayY",
    "viewX": "=mix(let.camX, let.infoCamX + let.infoSwayX, let.infoK)",
    "viewY": "=mix(let.camY, let.infoCamY + let.infoSwayY, let.infoK)",
    "viewZoom": "=mix(let.camZoom, let.infoZF * (1 + 0.006 * sin(time * motion.speed * 0.05)), let.infoK)",
    "viewRoll": "=(1 - let.infoK) * let.camRoll",
    "viewTiltX": "=(1 - let.infoK) * let.camTiltX",
    "viewTiltY": "=(1 - let.infoK) * let.camTiltY",

    "unit": "=viewport.min * 0.00066 * state.line.k",
    "lineAge": "=clock.lyrics - state.line.t0",
    "accentAge": "=clock.lyrics - state.line.accent.start",
    "inGap": "=state.line.index >= 0 && ((lyrics.isInterlude && clock.lyrics < (lyrics.next.start ?? 100000) - 0.6) || (isNull(lyrics.next) && (clock.lyrics > (lyrics.current.end ?? 100000) + 3 || let.endCard)))",
    "stageFade": "=state.gap.on == 1 ? 1 - smoothstep(1.1, 1.9, clock.lyrics - state.gap.t0) : 1",
    "stageHidden": "=state.gap.on == 1 && clock.lyrics - state.gap.t0 > 2",
    "lyricsDone": "=state.line.index >= 0 && isNull(lyrics.next) && clock.lyrics > (lyrics.current.end ?? 100000)",
    "lyricsShown": "=host.lyricsVisible || state.lyricsDone == 1",
    "endCard":"=let.lyricsDone && (track.duration ?? 0) > 0 && clock.remaining < 12",
    "gapTurn": "=state.gap.on == 1 && clock.lyrics >= (state.gap.next ?? 100000)",
    "ownCount": "=state.line.n ?? count(state.line.items)",
    "wordIndex": "=clamp(state.line.spread == 1 ? floor(lyricProgress(state.line.index) * let.ownCount) : lyrics.wordIndex, 0, max(0, let.ownCount - 1))",
    "titleSpan": "=min(0.62, 0.055 * measureText(track.title, 100, let.fontWeight, let.fontCJK) / 100) / 2 + 0.07",
    "orbitPhase": "=time * motion.speed * 0.55 * min(1, 0.3 / let.titleSpan) + index * 2 * pi / state.gap.dots",
    "pulse": "=0.5 + 0.5 * sin(let.orbitPhase)",

    "camSway": "=params.drift * follow(params.camera, 'camDrift', let.camEase)",
    "camEase": "=0.5 * (1 - smoothstep(0.8, 2.8, params.camera)) + 0.3 * max(0, 1 - 2 * let.tempoK)",
    "wordFollow": "=let.tempoK < 0.5 ? mix(0.25, 0.6, 2 * let.tempoK) : mix(0.6, 0.85, 2 * let.tempoK - 1)",
    "wordTime": "=let.tempoK < 0.5 ? mix(1.8, 1, 2 * let.tempoK) : mix(1, 0.7, 2 * let.tempoK - 1)",
    "camHit": "=smoothstep(1.2, 3, params.camera)",
